{
    "name": "teznevise/wp-mcp-suite",
    "description": "Modular WordPress content, SEO, analytics, reporting, backup and Microsoft 365 sync platform.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-gd": "*",
        "phpoffice/phpword": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpstan/phpstan": "^1.11",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MCPSuite\\": "includes/",
            "PhpOffice\\PhpWord\\": "vendor/phpoffice/phpword/src/PhpWord/",
            "PhpOffice\\Math\\": "vendor/phpoffice/math/src/Math/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MCPSuite\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist includes/",
        "stan": "phpstan analyse includes/ --level=6",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
