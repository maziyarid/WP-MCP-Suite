<?xml version="1.0"?>
<ruleset name="WP MCP Suite">
    <description>Coding standard for WP MCP Suite.</description>

    <file>includes</file>
    <file>wp-mcp-suite.php</file>
    <file>uninstall.php</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <!-- Namespaced, PSR-4 classes use StudlyCaps filenames, not the
             legacy "class-{name}.php" WP core convention. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-mcp-suite"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="PHPCompatibilityWP"/>
</ruleset>
